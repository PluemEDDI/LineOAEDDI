# Copy to .env and fill in from the LINE Developers console
# (Messaging API channel → "Basic settings" / "Messaging API" tabs)
CHANNEL_ACCESS_TOKEN=your-long-lived-channel-access-token
CHANNEL_SECRET=your-channel-secret

# Public HTTPS base URL where this server is reachable (no trailing slash).
# Used to build image URLs. For local testing with ngrok, e.g.:
#   BASE_URL=https://abcd-1234.ngrok-free.app
BASE_URL=http://localhost:3000

PORT=3000

# Optional: Discord webhook URL. When set, the bot posts a structured
# notification (message, user, best-guess intent tags) each time a free-text
# message is handed off to a human. Leave blank to disable.
DISCORD_WEBHOOK_URL=

# Optional: Discord user IDs to @mention (ping) on a new handoff, so only the
# LINE OA handler(s) are notified — everyone else just sees the message.
# Comma-separated. Get an ID via Discord → User Settings → Advanced → Developer
# Mode, then right-click the user → Copy User ID. Empty = nobody is pinged.
DISCORD_HANDLER_IDS=

# Optional: in-process daily report scheduler. When REPORT_ENABLED=true the bot
# posts a support-case summary to Discord each day at REPORT_HOUR:REPORT_MINUTE
# (local time in REPORT_TZ). Needs DATABASE_URL + DISCORD_WEBHOOK_URL. No cron
# service required. REPORT_DAYS = how many days back each report covers.
REPORT_ENABLED=false
REPORT_HOUR=18
REPORT_MINUTE=0
REPORT_TZ=Asia/Bangkok
REPORT_DAYS=1

# Optional: Google Sheet mirror. When set to a Google Apps Script web app URL
# (https://script.google.com/macros/s/.../exec whose doPost appends a row),
# every chat event is ALSO forwarded there — the LOG_BACKEND copy is kept too.
# Treat the URL as a secret (anyone with it can write to the Sheet).
SHEET_WEBHOOK_URL=

# Optional: how long (minutes) the bot stays silent after an admin manually
# replies to a user in the OA console. During this window, user acknowledgments
# like "ได้ครับ" / "ได้ค่ะ" are suppressed so the bot doesn't interrupt a live
# human conversation. Default: 10. Set to 0 to disable.
ADMIN_REPLY_COOLDOWN_MIN=10

# Optional: minutes the bot stays silent after it fires an intent-matched reply.
# Gives admins a natural window to jump in without the bot cutting in on every
# follow-up. Set to 0 to disable. Default: 3.
BOT_REPLY_COOLDOWN_MIN=3

# Required for the Discord "🔇 Silence bot" button to work.
# Set to any long random string (e.g. openssl rand -hex 16).
# The /silence endpoint rejects requests without this token.
SILENCE_TOKEN=
