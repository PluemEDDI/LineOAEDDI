# Copy to .env and fill in from the LINE Developers console
# (Messaging API channel → "Basic settings" / "Messaging API" tabs)
CHANNEL_ACCESS_TOKEN=your-long-lived-channel-access-token
CHANNEL_SECRET=your-channel-secret

# Public HTTPS base URL where this server is reachable (no trailing slash).
# Used to build image URLs. For local testing with ngrok, e.g.:
#   BASE_URL=https://abcd-1234.ngrok-free.app
BASE_URL=http://localhost:3000

PORT=3000
